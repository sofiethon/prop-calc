# Kopiere diese Datei zu `.env.local` und trage deine Werte ein.
# `.env.local` wird NICHT committed (steht in .gitignore). Niemals Keys in den Code schreiben.

# Supabase (Tag 2) – im Supabase-Projekt oben auf „Connect“ klicken, Framework Next.js wählen: dort stehen URL und Publishable Key
NEXT_PUBLIC_SUPABASE_URL=
# Publishable Key (beginnt mit sb_publishable_) – darf in den Browser, durch Row Level Security geschützt
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adobe Fonts: Projekt-ID des Web-Projekts mit der Schrift Superclarendon (öffentlich, kein Geheimnis)
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=
